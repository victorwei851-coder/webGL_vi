# 依赖目录（不要提交到远程仓库）
node_modules/
jspm_packages/
bower_components/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# 包管理器缓存与日志
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 构建产物与本地缓存
dist/
build/
.vite/
.cache/
.parcel-cache/
*.tsbuildinfo

# 本地环境文件（含天地图 key，不上传）

# 本地地图数据（自行上传的 shp / geojson 等）
/data/
/public/data/

# 编辑器
.vscode/
.idea/
.DS_Store

# 注意：package-lock.json / yarn.lock / pnpm-lock.yaml 需要提交，用于锁定依赖版本
# 注意：.env.example 是配置模板，需要提交
